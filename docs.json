{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "artikit-docs",
  "locales": [
    {
      "locale": "zh",
      "name": "中文",
      "default": true
    },
    {
      "locale": "en",
      "name": "English"
    }
  ],
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
    "navigation": {
    "languages": [
      {
        "language": "zh",
        "tabs": [
          {
            "tab": "文档",
            "groups": [
              {
                "group": "入门",
                "pages": [
                  "zh/index",
                  "zh/quickstart"
                ]
              },
              {
                "group": "基础知识",
                "pages": [
                  "zh/fundamentals/board-overview",
                  "zh/fundamentals/pins"
                ]
              },
              {
                "group": "模块使用",
                "pages": [
                  "zh/modules/pir",
                  "zh/modules/co2",
                  "zh/modules/ir",
                  "zh/modules/fan"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Docs",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "en/index",
                  "en/quickstart"
                ]
              },
              {
                "group": "Fundamentals",
                "pages": [
                  "en/fundamentals/board-overview",
                  "en/fundamentals/pins"
                ]
              },
              {
                "group": "Modules",
                "pages": [
                  "en/modules/pir",
                  "en/modules/co2",
                  "en/modules/ir",
                  "en/modules/fan"
                ]
              }
            ]
          }
        ]
      }
    ]
  },

  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
